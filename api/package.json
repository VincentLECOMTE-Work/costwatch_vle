{
  "name": "costwatch-api",
  "version": "0.9.5",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "migrate": "node src/migrate.js",
    "ingest:ce": "node src/ingest-ce.js",
    "ingest:metrics": "node src/ingest-metrics-all.js",
    "ingest:delta": "node src/ingest-delta.js",
    "ingest:ri": "node src/ingest-ri.js",
    "ingest:metrics:auto": "node src/ingest-metrics-auto.js",
    "ingest:metrics:auto:dry": "node src/ingest-metrics-auto.js --dry-run",
    "ingest:metrics:auto:scheduler": "node src/ingest-metrics-scheduler.js",
    "ingest:ec2:snapshot": "node src/ingest-ec2-snapshot.js",
    "ingest:ec2:snapshot:scheduler": "node src/ingest-ec2-snapshot-scheduler.js",
    "ingest:sp:cache": "node src/ingest-sp-cache.js",
    "ingest:sp:cache:force": "node src/ingest-sp-cache.js --force-refresh",
    "ingest:s3:delta": "node src/ingest-s3-delta.js",
    "ingest:metrics:s3": "node src/ingest-all.js",
    "db:migrate:s3": "node src/run-sql-file.js sql/20251026_add_s3_bucket_daily.sql",
    "db:migrate:s3:src": "node src/run-sql-file.js src/sql/20251026_add_s3_bucket_daily.sql",
    "db:migrate:s3:absolute": "node src/run-sql-file.js /app/sql/20251026_add_s3_bucket_daily.sql",
    "ingest:metrics:all": "node src/ingest-metrics-all.js",
    "ingest:s3:range": "node src/ingest-s3-range.js --from $FROM --to $TO",
    "print:scripts": "node -e \"console.log(require('./package.json').scripts)\"",
    "test": "node --test"
  },
  "dependencies": {
    "@aws-sdk/client-accessanalyzer": "^3.645.0",
    "@aws-sdk/client-cloudtrail": "^3.645.0",
    "@aws-sdk/client-cloudwatch": "^3.645.0",
    "@aws-sdk/client-config-service": "^3.645.0",
    "@aws-sdk/client-cost-explorer": "^3.645.0",
    "@aws-sdk/client-dynamodb": "^3.645.0",
    "@aws-sdk/client-ec2": "^3.645.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.645.0",
    "@aws-sdk/client-guardduty": "^3.645.0",
    "@aws-sdk/client-organizations": "^3.645.0",
    "@aws-sdk/client-pricing": "^3.600.0",
    "@aws-sdk/client-s3": "^3.645.0",
    "@aws-sdk/client-savingsplans": "^3.940.0",
    "@aws-sdk/client-securityhub": "^3.645.0",
    "@aws-sdk/client-sts": "^3.645.0",
    "@aws-sdk/lib-dynamodb": "^3.645.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "pg": "^8.11.5"
  }
}
